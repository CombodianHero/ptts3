{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/payment/:token",
      "destination": "/payment.html?token=:token"
    },
    {
      "source": "/invoice/:bookingId",
      "destination": "/invoice.html?bookingId=:bookingId"
    }
  ]
}
